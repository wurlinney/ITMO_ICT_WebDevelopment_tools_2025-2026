{"config":{"lang":["ru"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u041e\u0442\u0447\u0435\u0442\u044b \u043f\u043e \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u043c \u0440\u0430\u0431\u043e\u0442\u0430\u043c \u043f\u043e \u0412\u0435\u0431-\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e","text":"<p>\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u043b\u0430: \u0413\u0430\u0439\u0434\u0443\u043a \u0410\u043b\u0438\u043d\u0430 \u0413\u0440\u0443\u043f\u043f\u0430: \u041a3341</p> <p>\u0421\u0441\u044b\u043b\u043a\u0430 \u043d\u0430 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439: https://github.com/wurlinney/ITMO_ICT_WebDevelopment_tools_2025-2026</p>"},{"location":"api/","title":"API","text":""},{"location":"api/#_1","title":"\u0410\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f","text":"<ul> <li><code>POST /auth/register</code> - \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f</li> <li><code>POST /auth/login</code> - \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u0438 \u0432\u044b\u0434\u0430\u0447\u0430 \u043f\u0430\u0440\u044b \u0442\u043e\u043a\u0435\u043d\u043e\u0432 (<code>access_token</code>, <code>refresh_token</code>)</li> <li><code>POST /auth/refresh</code> - \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0430\u0440\u044b \u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u043f\u043e <code>refresh_token</code></li> </ul>"},{"location":"api/#_2","title":"\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438","text":"<ul> <li><code>GET /users</code> - \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439</li> <li><code>GET /users/{user_id}</code> - \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043f\u043e id (\u0434\u043e\u0441\u0442\u0443\u043f \u0442\u043e\u043b\u044c\u043a\u043e \u043a \u0441\u0432\u043e\u0435\u043c\u0443 id)</li> <li><code>PUT /users/{user_id}</code> - \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f (\u0434\u043e\u0441\u0442\u0443\u043f \u0442\u043e\u043b\u044c\u043a\u043e \u043a \u0441\u0432\u043e\u0435\u043c\u0443 id)</li> <li><code>DELETE /users/{user_id}</code> - \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f (\u0434\u043e\u0441\u0442\u0443\u043f \u0442\u043e\u043b\u044c\u043a\u043e \u043a \u0441\u0432\u043e\u0435\u043c\u0443 id)</li> <li><code>GET /users/{user_id}/with-tasks</code> - \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0441 \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438 (\u0434\u043e\u0441\u0442\u0443\u043f \u0442\u043e\u043b\u044c\u043a\u043e \u043a \u0441\u0432\u043e\u0435\u043c\u0443 id)</li> <li><code>POST /users/change-password</code> - \u0441\u043c\u0435\u043d\u0430 \u043f\u0430\u0440\u043e\u043b\u044f</li> </ul>"},{"location":"api/#_3","title":"\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438","text":"<ul> <li><code>POST /categories</code></li> <li><code>GET /categories</code></li> <li><code>GET /categories/{category_id}</code></li> <li><code>PUT /categories/{category_id}</code></li> <li><code>DELETE /categories/{category_id}</code></li> </ul>"},{"location":"api/#_4","title":"\u0422\u0435\u0433\u0438","text":"<ul> <li><code>POST /tags</code></li> <li><code>GET /tags</code></li> <li><code>GET /tags/{tag_id}</code></li> <li><code>PUT /tags/{tag_id}</code></li> <li><code>DELETE /tags/{tag_id}</code></li> </ul>"},{"location":"api/#_5","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u044f","text":"<ul> <li><code>POST /tasks</code></li> <li><code>GET /tasks</code></li> <li><code>GET /tasks/{task_id}</code> - \u0437\u0430\u0434\u0430\u0447\u0430 \u0441 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0435\u0439, \u0442\u0435\u0433\u0430\u043c\u0438 \u0438 \u043b\u043e\u0433\u0430\u043c\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438</li> <li><code>PUT /tasks/{task_id}</code></li> <li><code>DELETE /tasks/{task_id}</code></li> <li><code>POST /tasks/{task_id}/tags</code> - \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0430 \u0442\u0435\u0433\u0430 \u043a \u0437\u0430\u0434\u0430\u0447\u0435 \u0447\u0435\u0440\u0435\u0437 <code>task_tags</code></li> <li><code>DELETE /tasks/{task_id}/tags/{tag_id}</code> - \u043e\u0442\u0432\u044f\u0437\u043a\u0430 \u0442\u0435\u0433\u0430</li> <li><code>GET /tasks/analytics/summary</code> - \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0430</li> </ul>"},{"location":"api/#_6","title":"\u0424\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f \u0438 \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u0437\u0430\u0434\u0430\u0447","text":"<p>\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u043e \u0432 <code>GET /tasks</code>:</p> <ul> <li>\u0444\u0438\u043b\u044c\u0442\u0440\u044b: <code>status</code>, <code>priority</code>, <code>deadline_from</code>, <code>deadline_to</code></li> <li>\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430: <code>sort_by=deadline|priority|created_at</code></li> <li>\u043f\u043e\u0440\u044f\u0434\u043e\u043a: <code>sort_order=asc|desc</code></li> </ul>"},{"location":"api/#time-logs","title":"Time Logs","text":"<ul> <li><code>POST /time-logs</code></li> <li><code>GET /time-logs</code></li> <li><code>GET /time-logs/{time_log_id}</code></li> <li><code>PUT /time-logs/{time_log_id}</code></li> <li><code>DELETE /time-logs/{time_log_id}</code></li> </ul>"},{"location":"api/#_7","title":"\u0420\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f","text":"<ul> <li><code>POST /schedules</code></li> <li><code>GET /schedules</code></li> <li><code>GET /schedules/day/{plan_date}</code> - \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043d\u0430 \u0434\u0435\u043d\u044c \u0441 \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438</li> <li><code>GET /schedules/{schedule_id}</code></li> <li><code>PUT /schedules/{schedule_id}</code></li> <li><code>DELETE /schedules/{schedule_id}</code></li> </ul>"},{"location":"api/#_8","title":"\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f","text":"<ul> <li><code>POST /notifications</code></li> <li><code>GET /notifications</code></li> <li><code>GET /notifications/{notification_id}</code></li> <li><code>PUT /notifications/{notification_id}</code></li> <li><code>DELETE /notifications/{notification_id}</code></li> </ul>"},{"location":"api/#_9","title":"\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0435\u0440\u0432\u0438\u0441\u0430","text":"<ul> <li><code>GET /health</code> - \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 API</li> </ul>"},{"location":"github_links/","title":"GitHub \u0441\u0441\u044b\u043b\u043a\u0438","text":""},{"location":"github_links/#_1","title":"\u0420\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439 \u0438 \u0432\u0435\u0442\u043a\u0430","text":"<ul> <li>\u0420\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439: https://github.com/wurlinney/ITMO_ICT_WebDevelopment_tools_2025-2026</li> </ul>"},{"location":"github_links/#_2","title":"\u0421\u0441\u044b\u043b\u043a\u0438 \u043d\u0430 \u043f\u0430\u043f\u043a\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u043a","text":"<ul> <li>Practice 1: https://github.com/wurlinney/ITMO_ICT_WebDevelopment_tools_2025-2026/tree/main/students/k3341/Gaiduk_Alina/Lr1/practices/practice_1</li> <li>Practice 2: https://github.com/wurlinney/ITMO_ICT_WebDevelopment_tools_2025-2026/tree/main/students/k3341/Gaiduk_Alina/Lr1/practices/practice_2</li> <li>Practice 3: https://github.com/wurlinney/ITMO_ICT_WebDevelopment_tools_2025-2026/tree/main/students/k3341/Gaiduk_Alina/Lr1/practices/practice_3</li> </ul>"},{"location":"github_links/#1","title":"\u0421\u0441\u044b\u043b\u043a\u0430 \u043d\u0430 \u043f\u0430\u043f\u043a\u0443 \u041b\u04201","text":"<ul> <li>https://github.com/wurlinney/ITMO_ICT_WebDevelopment_tools_2025-2026/tree/main/students/k3341/Gaiduk_Alina/Lr1</li> </ul>"},{"location":"lr1/","title":"\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 1: FastAPI Time Manager","text":""},{"location":"lr1/#_1","title":"\u0426\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u044b","text":"<p>\u0420\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 FastAPI \u0434\u043b\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438 \u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c PostgreSQL, SQLAlchemy \u0438 Alembic.</p>"},{"location":"lr1/#_2","title":"\u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438","text":"<ul> <li>FastAPI</li> <li>SQLAlchemy 2.x</li> <li>PostgreSQL</li> <li>Alembic</li> <li>Pydantic v2</li> <li>Uvicorn</li> <li>JWT (PyJWT)</li> </ul>"},{"location":"lr1/#_3","title":"\u041a\u0440\u0430\u0442\u043a\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0434\u0430\u043d\u043d\u044b\u0445","text":"<p>\u0420\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u044b:</p> <ol> <li><code>users</code></li> <li><code>categories</code></li> <li><code>tasks</code></li> <li><code>tags</code></li> <li><code>task_tags</code> (many-to-many \u0441 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u043e\u043b\u044f\u043c\u0438)</li> <li><code>time_logs</code></li> <li><code>schedules</code></li> <li><code>notifications</code></li> </ol>"},{"location":"lr1/#_4","title":"\u0421\u0432\u044f\u0437\u0438","text":"<ul> <li>One-to-many:</li> <li><code>users -&gt; tasks</code></li> <li><code>users -&gt; categories</code></li> <li><code>tasks -&gt; time_logs</code></li> <li><code>users -&gt; schedules</code></li> <li><code>users -&gt; notifications</code></li> <li>Many-to-many:</li> <li><code>tasks &lt;-&gt; tags</code> \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u044f\u0437\u0443\u044e\u0449\u0443\u044e \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u044c <code>task_tags</code></li> </ul> <p>\u0412 <code>task_tags</code> \u0435\u0441\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043b\u044f: <code>tagged_at</code>, <code>weight</code>.</p>"},{"location":"lr1/#_5","title":"\u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430","text":"<pre><code>app/\n  api/\n    deps.py\n    routers/\n      auth.py\n      users.py\n      tasks.py\n      categories.py\n      tags.py\n      schedules.py\n      time_logs.py\n      notifications.py\n  core/\n    config.py\n    security.py\n  db/\n    base.py\n    base_class.py\n    session.py\n  models/\n    user.py\n    task.py\n    category.py\n    tag.py\n    task_tag.py\n    time_log.py\n    schedule.py\n    notification.py\n    enums.py\n  schemas/\n    auth.py\n    user.py\n    task.py\n    category.py\n    tag.py\n    time_log.py\n    schedule.py\n    notification.py\n    enums.py\n  main.py\n\nalembic/\n  env.py\n  versions/\n    20260411_01_initial_schema.py\n\nrequirements.txt\n.env.example\nalembic.ini\nlab_reports/\n</code></pre>"},{"location":"models_db/","title":"\u041c\u043e\u0434\u0435\u043b\u0438","text":""},{"location":"models_db/#users","title":"\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 (<code>users</code>)","text":"<ul> <li><code>id</code>, <code>email</code>, <code>full_name</code>, <code>hashed_password</code>, <code>is_active</code>, <code>created_at</code></li> <li>\u0441\u0432\u044f\u0437\u0438: <code>tasks</code>, <code>categories</code>, <code>schedules</code>, <code>notifications</code></li> </ul>"},{"location":"models_db/#categories","title":"\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 (<code>categories</code>)","text":"<ul> <li><code>id</code>, <code>name</code>, <code>owner_id</code></li> <li>\u0441\u0432\u044f\u0437\u0438: <code>owner</code>, <code>tasks</code></li> </ul>"},{"location":"models_db/#tasks","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u044f (<code>tasks</code>)","text":"<ul> <li><code>id</code>, <code>title</code>, <code>description</code>, <code>status</code>, <code>priority</code>, <code>deadline</code>, <code>estimated_minutes</code>, <code>owner_id</code>, <code>category_id</code>, <code>created_at</code>, <code>updated_at</code></li> <li>\u0441\u0432\u044f\u0437\u0438: <code>owner</code>, <code>category</code>, <code>time_logs</code>, <code>tag_links</code></li> </ul>"},{"location":"models_db/#tags","title":"\u0422\u0435\u0433\u0438 (<code>tags</code>)","text":"<ul> <li><code>id</code>, <code>name</code>, <code>created_at</code></li> <li>\u0441\u0432\u044f\u0437\u0438: <code>task_links</code></li> </ul>"},{"location":"models_db/#task_tags","title":"\u0422\u0435\u0433\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u044f (<code>task_tags</code>)","text":"<ul> <li><code>task_id</code>, <code>tag_id</code>, <code>tagged_at</code>, <code>weight</code></li> <li>\u0441\u0432\u044f\u0437\u0438: <code>task</code>, <code>tag</code></li> </ul>"},{"location":"models_db/#timelog-time_logs","title":"TimeLog (<code>time_logs</code>)","text":"<ul> <li><code>id</code>, <code>task_id</code>, <code>spent_minutes</code>, <code>started_at</code>, <code>ended_at</code>, <code>comment</code></li> <li>\u0441\u0432\u044f\u0437\u044c: <code>task</code></li> </ul>"},{"location":"models_db/#schedules","title":"\u0420\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f (<code>schedules</code>)","text":"<ul> <li><code>id</code>, <code>owner_id</code>, <code>task_id</code>, <code>plan_date</code>, <code>note</code></li> <li>\u0441\u0432\u044f\u0437\u0438: <code>owner</code>, <code>task</code></li> </ul>"},{"location":"models_db/#notifications","title":"\u0423\u0432\u0435\u0434\u043e\u043c\u043c\u043b\u0435\u043d\u0438\u044f (<code>notifications</code>)","text":"<ul> <li><code>id</code>, <code>owner_id</code>, <code>task_id</code>, <code>message</code>, <code>due_at</code>, <code>is_sent</code>, <code>created_at</code></li> <li>\u0441\u0432\u044f\u0437\u0438: <code>owner</code>, <code>task</code></li> </ul>"},{"location":"practices/","title":"\u0412\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u043a 1.1\u20131.3","text":"<p>\u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u044b \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b \u0432 \u043f\u0430\u043f\u043a\u0435 <code>practices</code>.</p>"},{"location":"practices/#11-practice_1","title":"\u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 1.1 (<code>practice_1</code>)","text":"<p>\u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u044f \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b\u0430 \u0431\u0430\u0437\u043e\u0432\u043e\u0435 FastAPI-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043f\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0441 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0431\u0430\u0437\u043e\u0439 \u0434\u0430\u043d\u043d\u044b\u0445, \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b\u0430 CRUD \u043f\u043e \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u044f\u043c <code>warrior</code> \u0438 <code>profession</code>,, \u0430 \u0442\u0430\u043a \u0436\u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0430 Pydantic-\u043c\u043e\u0434\u0435\u043b\u0438 \u0434\u043b\u044f \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u0438.</p> <p>\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0444\u0430\u0439\u043b\u044b:</p> <ul> <li><code>practices/practice_1/main.py</code></li> <li><code>practices/practice_1/models.py</code></li> </ul>"},{"location":"practices/#12-practice_2","title":"\u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 1.2 (<code>practice_2</code>)","text":"<p>\u0412 \u0445\u043e\u0434\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0432\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u044f \u043f\u0435\u0440\u0435\u0448\u043b\u0430 \u0441 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0431\u0434 \u043d\u0430 SQLModel, \u043e\u0431\u043d\u043e\u0432\u0438\u043b\u0430 \u043c\u043e\u0434\u0435\u043b\u0438 <code>Warrior</code>, <code>Profession</code>, <code>Skill</code> \u0438 M2M-\u0441\u0432\u044f\u0437\u044c \u0447\u0435\u0440\u0435\u0437 <code>SkillWarriorLink</code>. \u0422\u0430\u043a \u0436\u0435 \u044f \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0430 \u044d\u043d\u0434\u043f\u043e\u0438\u043d\u0442\u044b \u0434\u043b\u044f \u0432\u043e\u0438\u043d\u043e\u0432, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u0439, \u043d\u0430\u0432\u044b\u043a\u043e\u0432 \u0438 link-\u0442\u0430\u0431\u043b\u0438\u0446\u044b.</p> <p>\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0444\u0430\u0439\u043b\u044b:</p> <ul> <li><code>practices/practice_2/main.py</code></li> <li><code>practices/practice_2/models.py</code></li> <li><code>practices/practice_2/db.py</code></li> </ul>"},{"location":"practices/#13-practice_3","title":"\u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 1.3 (<code>practice_3</code>)","text":"<p>\u0412 \u0445\u043e\u0434\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 3 \u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043b\u0430 \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0439 Alembic, \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f URL \u0411\u0414, \u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0430 \u043f\u043e\u043b\u0435 <code>level</code> \u0432 <code>SkillWarriorLink</code>.</p>"}]}