APP_NAME=Time Manager API
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://app_user:app_password@127.0.0.1:5432/time_manager
# Пароль пользователя postgres (тот, что при установке PostgreSQL). Вместо CHANGE_ME — ваш пароль.
POSTGRES_BOOTSTRAP_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# Если пароль сложный (@ : # и т.д.) — уберите его из строки выше и раскомментируйте две строки ниже:
# POSTGRES_BOOTSTRAP_URL=postgresql+psycopg://postgres@127.0.0.1:5432/postgres
# POSTGRES_BOOTSTRAP_PASSWORD=
JWT_SECRET_KEY=jwt-password-top
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
